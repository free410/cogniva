# 复制为 backend/.env 后填入真实密钥（该文件不会被提交到 Git）

# ===== 数据库（本地直接运行后端时使用；Docker 内由 compose 覆盖）=====
DATABASE_URL=postgresql://postgres:change-me-please@127.0.0.1:5433/knowledge_assistant_pgvector
REDIS_URL=redis://127.0.0.1:6379/0

# ===== 大模型 =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 向量化（DashScope text-embedding-v3）=====
DASHSCOPE_API_KEY=

# ===== 本地模型 =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ===== 应用 =====
APP_SECRET=please-change-to-a-random-string
DEBUG=False
