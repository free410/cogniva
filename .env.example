# 复制为 .env 后按需修改（该文件不会被提交到 Git）

# ===== 数据库 =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=knowledge_assistant_pgvector

# ===== 访问端口 =====
HTTP_PORT=80

# ===== 前端访问后端的地址（构建期写入）=====
# 留空表示同源访问，由 nginx 把 /api 反向代理到后端（推荐，无需改）
# 若前后端分开部署，填 http://服务器IP:8000
NEXT_PUBLIC_API_URL=
